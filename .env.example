# ===========================================
# GeoHealth-JHCIS Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Application
NEXT_PUBLIC_API_URL=https://geohealth.phoubon.in.th
NEXTAUTH_URL=https://geohealth.phoubon.in.th
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# Database (Primary — MariaDB 11)
DATABASE_URL=mysql://geohealth:password@database:3306/geohealth

# Database (JHCIS — Read-only connection to existing JHCIS MySQL/MariaDB)
JHCIS_DATABASE_URL=mysql://jhcis_user:password@jhcis-server:3306/jhcis_db

# Redis (Cache + Queue)
REDIS_URL=redis://:password@redis:6379
REDIS_PASSWORD=your-redis-password

# MinIO (File Storage — photos, voice notes, exports)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=geohealth-uploads

# MariaDB (Docker container root credentials)
MARIADB_ROOT_PASSWORD=your-root-password
MARIADB_PASSWORD=your-db-password

# Monitoring
SENTRY_DSN=https://xxxx@sentry.phoubon.in.th/1

# Map (Optional — OpenStreetMap is free and used by default)
NEXT_PUBLIC_MAPBOX_TOKEN=
